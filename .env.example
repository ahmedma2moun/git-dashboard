# Login credentials for the dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-something-long

# Random string used to sign the session cookie (openssl rand -hex 32)
SESSION_SECRET=

# GitHub token. Classic PAT with scopes: repo, read:user, user (billing), read:org (for orgs)
GITHUB_TOKEN=

# Optional: comma-separated orgs whose Actions billing you also want to see
GITHUB_ORGS=
